# ============================================================================
# 金苹果之旅 — 环境变量模板
# ----------------------------------------------------------------------------
# 用法：复制成 .env 再填真实值（.env 已在 .gitignore 里，绝不会进仓库）
#     cp .env.example .env
#
# 部署到 Render / Railway：不要上传 .env 文件，而是在平台控制台的
#   Environment / Variables 页面逐条填（键名与此处一致）。
# ============================================================================


# ============================== ① 基础 / 部署 ==============================

# 监听端口。Render / Railway 会**自动注入** PORT（动态分配），留空即可。
# 本地开发不填则默认 3000。
# ⚠️ 不要为了「固定 3000」而在平台上覆盖它，否则平台探活会失败。
PORT=

# ★ 用户数据库路径（app.db）。优先级最高。
# 容器平台的文件系统是**临时**的，重新部署即清空 —— 必须挂持久化磁盘（Volume/Disk）
# 到某个目录，并把 DB_PATH 指向磁盘内的文件，例如： /data/app.db
# 不填 → 默认 ./data/app.db（相对项目根目录）
DB_PATH=

# 旧变量名，等价于 DB_PATH（历史上一直在用，测试脚本也依赖它）。
# 两个都填时 **DB_PATH 优先**。留空即可，仅为向后兼容保留。
DATABASE_PATH=

# ★ ECDICT 词典库路径（dictionary.db，约 58MB，只读参考数据）。
# 不填 → 默认 ./data/dictionary.db
# 提示：词典是「可整体重建的静态数据」，与 app.db 不同，**不必**放在持久化磁盘上；
#      放在镜像里每次部署重新下载/解压反而更省磁盘额度。
DICTIONARY_PATH=

# ★ 词典库下载地址（GitHub Release 资产的直链）。
# 由 postinstall（npm install 后自动执行）与 `npm run dict:download` 使用：
#   已存在且校验通过 → 跳过；下载失败 → 打警告并继续（词典层自动降级，不影响启动）。
# 例： https://github.com/<user>/<repo>/releases/download/dict-v1/dictionary.db
DICTIONARY_DOWNLOAD_URL=

# 设为 1 可跳过词典下载（离线构建 / CI 里不需要词典时用）
SKIP_DICT_DOWNLOAD=

# 访问密码：所有 /api 请求需带 x-access-password 头。留空 = **不校验**（仅限本地开发！）
ACCESS_PASSWORD=

# 未提供用户名时使用的默认用户名（对应 users.username）
DEFAULT_USERNAME=golden-apple-user

# 文章分析队列的最大重试次数
QUEUE_MAX_RETRIES=3

# 设为 true 时，服务启动会恢复上次中断的任务（默认关闭）
ENABLE_TASK_RECOVERY=


# ====================== ② LLM（文章分析 / 出题 / 查词） ======================
# 这三组是「直接调大模型 HTTP API」的配置，与下面的 Coze 知识库互不影响。

# 文章分析主力模型（默认回落到 GLM 的那套配置）
ARTICLE_API_KEY=
ARTICLE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ARTICLE_MODEL=glm-5.3-flash
# 主力模型连续失败时切换的备用模型
ARTICLE_FALLBACK_MODEL=deepseek-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 智谱 GLM
GLM_FLASH_API_KEY=
GLM_FLASH_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_FLASH_MODEL=glm-5.3-flash


# ==================== ③ L1 检索：Coze 知识库（可选） ====================
# 不配置 → 查词直接从 L2（本地语境库）开始，功能可用，只是少一层召回。
# ★ COZE_KB_SEARCH_WORKFLOW_ID 是 L1 的总开关：不填则整层跳过。

COZE_API_TOKEN=
COZE_KB_ID=
COZE_KB_API_KEY=
COZE_KB_BASE_URL=https://api.coze.cn

# word_context_search 工作流的 ID（必须在 Coze 控制台「发布」过）
COZE_KB_SEARCH_WORKFLOW_ID=
COZE_KB_WORKFLOW_PATH=/v1/workflow/run
COZE_KB_WORKFLOW_QUERY_PARAM=query
# 工作流里若含数据库 / 变量节点，必须在这里填它关联的智能体 ID
COZE_KB_WORKFLOW_BOT_ID=
COZE_KB_WORKFLOW_TIMEOUT_MS=30000

# 查询形态：two_step（默认，word 单独 → word,context 两轮，命中率最高）
#           word | legacy
COZE_KB_QUERY_MODE=two_step
COZE_KB_MAX_RETRIES=3

# 熔断冷却（毫秒）：额度耗尽 / 无权限 / 工作流未发布时，L1 暂停这么久不再白打接口
COZE_KB_CIRCUIT_COOLDOWN_MS=600000

# 查词（L3 AI 生成）的独立超时与重试 —— 刻意收紧，避免点词等太久
COZE_WORD_MEANING_TIMEOUT_MS=20000
COZE_WORD_MEANING_MAX_RETRIES=1


# ========================= ④ 高级调优（一般不用改） =========================

# 长文分片重试的字符阈值
CHUNK_TIMEOUT_RETRY_CHARS=1200
# 模型健康熔断：同模型连续失败 N 次 → 冷却 M 毫秒后改用备用模型
MODEL_HEALTH_FAIL_THRESHOLD=2
MODEL_HEALTH_COOLDOWN_MS=300000
# 知识库召回切片数与相关度阈值
COZE_KB_TOP_K=5
COZE_KB_SCORE_THRESHOLD=0.2
COZE_KB_QUERY_TYPE=0
COZE_KB_FILE_TYPE=txt


# ==================== ⑤ 以下变量已废弃，代码不再读取 ====================
# 保留在此仅作说明，**不要**再往部署平台里填（历史上来自 PG + Coze Bot 版本）：
#
#   DATABASE_URL / PG_HOST / PG_PORT / PG_USER / PG_PASSWORD / PG_DATABASE
#   REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
#       → 项目已改为 SQLite + 进程内队列，docker-compose.yml 只是迁移预留桩。
#   COZE_BOT_ID / COZE_WORKFLOW_ID / COZE_QUIZ_WORKFLOW_ID / COZE_WORD_WORKFLOW_ID
#   COZE_USER_ID / COZE_API_URL
#       → 旧的 Coze Bot / 工作流智能体形态；现在改由 ② 里的直连 LLM 配置承担。
#   COZE_KB_SEARCH_PATH / COZE_KB_CREATE_PATH / COZE_KB_DOCUMENTS_PATH /
#   COZE_KB_LIST_PATH / COZE_KB_DELETE_PATH / COZE_KB_UPLOAD_STYLE /
#   COZE_KB_CONTENT_MODE / COZE_KB_AUTO_DOC_PREFIX / COZE_KB_SYNC_*
#       → 知识库「自动上传」相关，2026-09-28 起改为手动同步（export_csv.js + 控制台上传），
#         相关代码已成对注释保留，不再生效。
